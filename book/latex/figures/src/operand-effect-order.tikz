% Operand evaluation precedes committing instruction effects.
\begin{tikzpicture}[font=\small,
  box/.style={draw=accent-700,fill=accent-50,rounded corners=2pt,
    minimum width=2.5cm,minimum height=.86cm,align=center},
  gate/.style={draw=ml-amber-800,fill=ml-amber-50,rounded corners=2pt,
    minimum width=2.5cm,minimum height=.86cm,align=center},
  good/.style={draw=ml-teal-700,fill=ml-teal-50,rounded corners=2pt,
    minimum width=2.7cm,minimum height=.86cm,align=center},
  bad/.style={draw=gray-600,fill=gray-100,rounded corners=2pt,
    minimum width=2.7cm,minimum height=.86cm,align=center},
  arr/.style={->,>=stealth,thick,gray-600}]
  \node[box] (snapshot) at (-4.5,0) {snapshot every\\required old value};
  \node[gate] (eval) at (-1.2,0) {evaluate operands\\and access memory};
  \node[good] (commit) at (3.4,1.15) {success: calculate and\\commit all effects};
  \node[bad] (fault) at (3.4,-1.15) {failure: apply the\\declared trap rule};
  \draw[arr] (snapshot)--(eval);
  \draw[arr] (eval)--node[above,sloped,font=\scriptsize]{complete}(commit);
  \draw[arr] (eval)--node[below,sloped,font=\scriptsize]{cannot complete}(fault);
\end{tikzpicture}
