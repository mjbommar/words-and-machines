\begin{tikzpicture}[
  word/.style={draw=gray-500,minimum width=1.25cm,minimum height=.8cm,align=center},
  arr/.style={-{Stealth[length=2.2mm]},thick,draw=accent-700}
]
  \foreach \x in {0,...,6} {
    \ifnum\x<3 \node[word,fill=accent-50] (w\x) at (1.3*\x,0) {$w_{\x}$};
    \else \node[word,fill=gray-100] (w\x) at (1.3*\x,0) {$w_{\x}$}; \fi
  }
  \draw[very thick,draw=ml-amber-800] (3.25,-.65)--(3.25,.65);
  \node[above] at (3.25,.7) {$p=a+8i$};
  \node[draw=accent-700,fill=accent-50,rounded corners=2pt,align=center] (acc) at (1.3,-1.8) {$x=\mathsf{foldxor}(M_0,a,i)$};
  \draw[arr] (1.3,-.45)--(acc.north);
  \node[align=center,text=gray-600] at (6.0,-1.8) {unread suffix\\$c=n-i$};
\end{tikzpicture}
