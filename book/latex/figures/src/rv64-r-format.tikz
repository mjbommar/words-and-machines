\begin{tikzpicture}[x=.205cm,y=1cm,font=\scriptsize]
  \def\field#1#2#3#4{\fill[#4] (#1,0) rectangle (#2,1);\draw[gray-700,thick] (#1,0) rectangle (#2,1);\node at ({(#1+#2)/2},.5) {#3};}
  \field{0}{7}{opcode}{ml-blue-50}
  \field{7}{12}{rd}{ml-teal-50}
  \field{12}{15}{funct3}{ml-amber-50}
  \field{15}{20}{rs1}{ml-teal-50}
  \field{20}{25}{rs2}{ml-teal-50}
  \field{25}{32}{funct7}{ml-amber-50}
  \foreach \x/\lab in {0/0,7/7,12/12,15/15,20/20,25/25,32/32} {\node[below] at (\x,-.02) {\lab};}
  \node[anchor=west] at (0,1.3) {least-significant bit};
  \node[anchor=east] at (32,1.3) {most-significant bit};
\end{tikzpicture}
