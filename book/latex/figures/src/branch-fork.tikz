% Taken and untaken paths from one conditional branch.
\begin{tikzpicture}[
  inst/.style={draw=accent-700, fill=accent-50, rounded corners=2pt,
    minimum width=2.2cm, minimum height=0.8cm, align=center, font=\small},
  target/.style={draw=gray-500, fill=gray-100, rounded corners=2pt,
    minimum width=2.15cm, minimum height=0.8cm, align=center, font=\small},
  arr/.style={->, >=stealth, line width=0.8pt, gray-600}]
  \node[inst] (b) at (0,0) {branch at \(pc\)};
  \node[target] (next) at (-3.2,-2.0) {untaken\\\(pc+4\)};
  \node[target] (taken) at (3.2,-2.0) {taken\\\(pc+4+4d\)};
  \draw[arr] (b) -- node[left,font=\scriptsize]{predicate false} (next);
  \draw[arr] (b) -- node[right,font=\scriptsize]{predicate true} (taken);
\end{tikzpicture}
