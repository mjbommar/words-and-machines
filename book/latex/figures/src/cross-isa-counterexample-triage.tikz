\begin{tikzpicture}[
  box/.style={draw=gray-500,fill=gray-100,rounded corners=2pt,minimum width=2.35cm,minimum height=.8cm,align=center},
  arr/.style={-{Stealth[length=2mm]},thick,draw=accent-700},
  reject/.style={-{Stealth[length=1.8mm]},dashed,draw=ml-amber-800}
]
  \node[box] (m) at (0,0) {solver model};
  \node[box] (p) at (2.9,0) {precondition};
  \node[box] (s) at (5.8,0) {state build};
  \node[box] (d) at (8.7,0) {decode};
  \node[box] (r) at (11.6,0) {segment replay};
  \node[box,fill=accent-50,draw=accent-700] (f) at (14.5,0) {failed clause};
  \foreach \x/\y in {m/p,p/s,s/d,d/r,r/f} \draw[arr] (\x)--(\y);
  \foreach \x in {p,s,d,r} \draw[reject] (\x.south)--++(0,-.85) node[below]{reject};
\end{tikzpicture}
