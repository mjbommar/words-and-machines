% Carry propagation across three words.
\begin{tikzpicture}[font=\small,
  word/.style={draw=accent-700,fill=accent-50,rounded corners=2pt,
    minimum width=2.45cm,minimum height=1.0cm,align=center},
  arr/.style={->,>=stealth,thick,ml-amber-800}]
  \node[word] (lo) at (-3.3,0) {low-word add\\\(x_0+y_0\)};
  \node[word] (mid) at (0,0) {middle-word add\\\(x_1+y_1+c_1\)};
  \node[word] (hi) at (3.3,0) {high-word add\\\(x_2+y_2+c_2\)};
  \draw[arr] (lo)--node[above]{\(c_1\)}(mid);
  \draw[arr] (mid)--node[above]{\(c_2\)}(hi);
  \draw[arr] (hi)--++(1.8,0) node[right]{\(c_3\)};
  \node[font=\scriptsize,text=gray-600,align=center] at (0,-1.25)
    {Each carry is data for the next word, whether stored in a flag or an ordinary register.};
\end{tikzpicture}
