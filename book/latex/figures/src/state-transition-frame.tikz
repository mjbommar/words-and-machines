% A complete transition separates changed and preserved components.
\begin{tikzpicture}[font=\small,
  state/.style={draw=accent-700,fill=accent-50,rounded corners=2pt,
    minimum width=3.0cm,minimum height=.9cm,align=center},
  change/.style={draw=ml-teal-700,fill=ml-teal-50,rounded corners=2pt,
    minimum width=3.0cm,minimum height=.8cm,align=center},
  frame/.style={draw=gray-600,fill=gray-100,rounded corners=2pt,
    minimum width=3.0cm,minimum height=.8cm,align=center},
  arr/.style={->,>=stealth,thick,gray-600}]
  \node[state] (old) at (-4,0) {old complete state\\\(S\)};
  \node[change] (writes) at (0,1.25) {declared writes\\receive new values};
  \node[frame] (preserve) at (0,-1.25) {all other components\\retain old values};
  \node[state] (new) at (4,0) {new complete state\\\(S'\)};
  \draw[arr] (old)--(writes);
  \draw[arr] (old)--(preserve);
  \draw[arr] (writes)--(new);
  \draw[arr] (preserve)--(new);
\end{tikzpicture}
