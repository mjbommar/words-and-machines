% The complete A0 state and three example observations.
\begin{tikzpicture}[
  component/.style={draw=gray-500, fill=gray-100, rounded corners=2pt,
    minimum width=2.05cm, minimum height=0.72cm, align=center, font=\small},
  state/.style={draw=accent-700, fill=accent-50, rounded corners=2pt,
    minimum width=3.0cm, minimum height=0.9cm,
    text=accent-700, font=\bfseries\small},
  obs/.style={draw=ml-teal-700, fill=ml-teal-50, rounded corners=2pt,
    minimum width=2.5cm, minimum height=0.72cm, align=center, font=\small},
  arr/.style={->, >=stealth, line width=0.7pt, gray-500},
  project/.style={->, >=stealth, dashed, line width=0.8pt, ml-teal-700}]
  \node[state] (s) at (0,0) {complete A0 state};
  \node[component] (r) at (-4.0,2.0) {registers};
  \node[component] (m) at (-1.35,2.0) {data memory};
  \node[component] (pc) at (1.35,2.0) {program counter};
  \node[component] (flags) at (4.0,2.0) {condition bits};
  \node[component] (outcome) at (0,-2.0) {outcome};
  \draw[arr] (r) -- (s);
  \draw[arr] (m) -- (s);
  \draw[arr] (pc) -- (s);
  \draw[arr] (flags) -- (s);
  \draw[arr] (outcome) -- (s);
  \node[obs] (o1) at (-4.0,-3.7) {output register};
  \node[obs] (o2) at (0,-3.7) {registers + outcome};
  \node[obs] (o3) at (4.0,-3.7) {full state};
  \draw[project] (s) -- (o1);
  \draw[project] (s) -- (o2);
  \draw[project] (s) -- (o3);
\end{tikzpicture}
