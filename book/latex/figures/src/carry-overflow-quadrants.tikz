\begin{tikzpicture}[font=\small,x=3.25cm,y=1.55cm]
  \draw[gray-700,thick] (0,0) rectangle (2,2);
  \draw[gray-700] (1,0) -- (1,2);
  \draw[gray-700] (0,1) -- (2,1);
  \fill[ml-blue-50] (0,0) rectangle (1,1);
  \fill[ml-amber-50] (1,0) rectangle (2,1);
  \fill[ml-teal-50] (0,1) rectangle (1,2);
  \fill[callout-warning-bg] (1,1) rectangle (2,2);
  \draw[gray-700,thick] (0,0) rectangle (2,2);
  \draw[gray-700] (1,0) -- (1,2);
  \draw[gray-700] (0,1) -- (2,1);
  \node[align=center] at (.5,.5) {\texttt{0010+0011=0101}\\\(C=0,V=0\)};
  \node[align=center] at (1.5,.5) {\texttt{0111+0001=1000}\\\(C=0,V=1\)};
  \node[align=center] at (.5,1.5) {\texttt{1111+0001=0000}\\\(C=1,V=0\)};
  \node[align=center] at (1.5,1.5) {\texttt{1000+1000=0000}\\\(C=1,V=1\)};
  \node[below] at (.5,-.12) {no signed overflow};
  \node[below] at (1.5,-.12) {signed overflow};
  \node[rotate=90,above] at (-.12,.5) {no carry};
  \node[rotate=90,above] at (-.12,1.5) {carry};
\end{tikzpicture}
