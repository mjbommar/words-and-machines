(set-logic QF_BV)
; I.thm.popcount32 : Hacker's Delight Fig. 5-2 popcount equals the bit-sum spec, 32-bit. Expected: unsat.
(declare-const x (_ BitVec 32))
(define-fun step1 () (_ BitVec 32) (bvsub x (bvand (bvlshr x #x00000001) #x55555555)))
(define-fun step2 () (_ BitVec 32) (bvadd (bvand step1 #x33333333) (bvand (bvlshr step1 #x00000002) #x33333333)))
(define-fun step3 () (_ BitVec 32) (bvand (bvadd step2 (bvlshr step2 #x00000004)) #x0F0F0F0F))
(define-fun step4 () (_ BitVec 32) (bvadd step3 (bvlshr step3 #x00000008)))
(define-fun step5 () (_ BitVec 32) (bvadd step4 (bvlshr step4 #x00000010)))
(define-fun hd () (_ BitVec 32) (bvand step5 #x0000003F))
(define-fun bit ((i (_ BitVec 32))) (_ BitVec 32) (bvand (bvlshr x i) #x00000001))
(define-fun spec () (_ BitVec 32)
  (bvadd (bit #x00000000) (bvadd (bit #x00000001) (bvadd (bit #x00000002) (bvadd (bit #x00000003) (bvadd (bit #x00000004) (bvadd (bit #x00000005) (bvadd (bit #x00000006) (bvadd (bit #x00000007)
  (bvadd (bit #x00000008) (bvadd (bit #x00000009) (bvadd (bit #x0000000A) (bvadd (bit #x0000000B) (bvadd (bit #x0000000C) (bvadd (bit #x0000000D) (bvadd (bit #x0000000E) (bvadd (bit #x0000000F)
  (bvadd (bit #x00000010) (bvadd (bit #x00000011) (bvadd (bit #x00000012) (bvadd (bit #x00000013) (bvadd (bit #x00000014) (bvadd (bit #x00000015) (bvadd (bit #x00000016) (bvadd (bit #x00000017)
  (bvadd (bit #x00000018) (bvadd (bit #x00000019) (bvadd (bit #x0000001A) (bvadd (bit #x0000001B) (bvadd (bit #x0000001C) (bvadd (bit #x0000001D) (bvadd (bit #x0000001E) (bit #x0000001F)))))))))))))))))))))))))))))))))
(assert (not (= hd spec)))
(check-sat)
