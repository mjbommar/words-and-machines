{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mjbommar/instruction-sets-programs-and-proofs/artifacts/schema/manifest.schema.json",
  "title": "Book evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "statement", "scope", "exclusions", "trust_class", "semantic_inputs", "artifacts", "producer", "checker", "negative_control", "environment", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "claim_id": {"type": "string", "pattern": "^(A0|RV64|X64|REL|EVID)\\.[A-Za-z0-9._-]+$"},
    "statement": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "trust_class": {"enum": ["trace", "computation", "verdict", "certificate", "kernel"]},
    "semantic_inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "path", "sha256"],
        "properties": {
          "name": {"type": "string"}, "version": {"type": "string"},
          "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"enum": ["trace", "formula", "model", "certificate", "kernel-term", "report"]}
        }
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false, "required": ["command", "version"],
      "properties": {"command": {"type": "string"}, "version": {"type": "string"}}
    },
    "checker": {
      "type": "object", "additionalProperties": false, "required": ["command", "version", "expected_result"],
      "properties": {"command": {"type": "string"}, "version": {"type": "string"}, "expected_result": {"type": "string"}}
    },
    "negative_control": {
      "type": "object", "additionalProperties": false, "required": ["command", "expected_failure", "mutates"],
      "properties": {"command": {"type": "string"}, "expected_failure": {"type": "string"}, "mutates": {"type": "string"}}
    },
    "environment": {
      "type": "object", "required": ["axeyum_revision"],
      "properties": {"axeyum_revision": {"type": "string"}}, "additionalProperties": true
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "created": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  }
}
